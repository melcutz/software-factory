#!/usr/bin/env python3
"""factory/bin/route — risk + surfaces -> reviewers + models via config.json.

Usage: route <job-folder>
Reads intake.md from the job folder, looks up routing in config.json,
prints a JSON object with the reviewers and their models.
"""
import json, os, sys, re

def main():
    if len(sys.argv) < 2:
        print("Usage: route <job-folder>", file=sys.stderr)
        sys.exit(1)
    job_dir = sys.argv[1]
    config_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "config.json")
    with open(config_path) as f:
        config = json.load(f)

    intake_path = os.path.join(job_dir, "intake.md")
    with open(intake_path) as f:
        intake = f.read()

    # Parse intake.md
    risk = "low"
    surfaces = "none"
    for line in intake.splitlines():
        m = re.match(r"RISK:\s*(\w+)", line)
        if m: risk = m.group(1).lower()
        m = re.match(r"SURFACES:\s*(.+)", line)
        if m: surfaces = m.group(1).strip().lower()

    routing = config["routing"]
    surface_reviewers = config["surface_reviewers"]
    models = config.get("models", {})

    reviewers = {}
    # Base code reviewer
    base = routing.get(risk, routing.get("low", {}))
    reviewers["code"] = base.get("code", "opencode-go/glm-5.3-flash")

    # Surface reviewers
    for surf in [s.strip() for s in surfaces.split(",")]:
        if surf in surface_reviewers:
            for name, model in surface_reviewers[surf].items():
                reviewers[name] = model

    # Map reviewer names to opencode go model IDs if needed
    # (config already uses full model IDs like opencode-go/glm-5.3-flash)

    result = {
        "risk": risk,
        "surfaces": surfaces,
        "reviewers": reviewers,
    }
    print(json.dumps(result, indent=2))

if __name__ == "__main__":
    main()