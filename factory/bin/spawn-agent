#!/usr/bin/env python3
"""factory/bin/spawn-agent — spawn a subagent via herdr for Google Antigravity (agy).

Usage: spawn-agent <agent-name> <model> <job-id> <prompt> [--timeout SEC] [--marker TEXT]

Creates a herdr pane, runs agy with the agent definition prepended to the prompt,
waits for completion (via output marker), and returns the pane ID.

Agent definitions are read from factory/agents/<agent-name>.md

Environment:
  HERDR_PANE_ID  — the orchestrator's pane (required, or auto-detected)
  PROJECT_ROOT   — the project root (defaults to cwd)
"""
import json, os, sys, subprocess, shlex, time

def herdr(*args):
    result = subprocess.run(["herdr"] + list(args), capture_output=True, text=True)
    if result.returncode != 0:
        print(f"herdr error: {result.stderr}", file=sys.stderr)
    return result

def main():
    if len(sys.argv) < 5:
        print("Usage: spawn-agent <agent-name> <model> <job-id> <prompt> [--timeout SEC] [--marker TEXT]", file=sys.stderr)
        sys.exit(1)

    agent_name = sys.argv[1]
    model = sys.argv[2]
    job_id = sys.argv[3]
    prompt = sys.argv[4]
    timeout = 600
    marker = None
    if "--timeout" in sys.argv:
        idx = sys.argv.index("--timeout")
        timeout = int(sys.argv[idx + 1])
    if "--marker" in sys.argv:
        idx = sys.argv.index("--marker")
        marker = sys.argv[idx + 1]

    orch_pane = os.environ.get("HERDR_PANE_ID")
    if not orch_pane:
        r = herdr("pane", "current")
        try:
            orch_pane = json.loads(r.stdout)["result"]["pane"]["pane_id"]
        except Exception:
            print("HERDR_PANE_ID not set and could not get current pane", file=sys.stderr)
            sys.exit(1)

    project_root = os.environ.get("PROJECT_ROOT", os.getcwd())

    # Read agent definition
    agent_def_path = os.path.join(project_root, "factory", "agents", f"{agent_name}.md")
    agent_instructions = ""
    if os.path.exists(agent_def_path):
        with open(agent_def_path) as f:
            # Skip frontmatter, use body as instructions
            content = f.read()
            if content.startswith("---"):
                parts = content.split("---", 2)
                if len(parts) >= 3:
                    agent_instructions = parts[2].strip()
                else:
                    agent_instructions = content
            else:
                agent_instructions = content

    # Special handling for ponytail-audit security review
    skill_hint = ""
    if agent_name == "reviewer-security":
        skill_hint = "\n\nIMPORTANT: Use the ponytail-audit skill (invoke /ponytail-audit) to perform a thorough security audit of the codebase. Focus on security holes, injection risks, secrets, auth issues, and data loss."

    # Split a new pane
    r = herdr("pane", "split", orch_pane, "--direction", "right")
    try:
        pane_id = json.loads(r.stdout)["result"]["pane"]["pane_id"]
    except Exception:
        print(f"Failed to split pane: {r.stdout} {r.stderr}", file=sys.stderr)
        sys.exit(1)

    # Build the full prompt: agent instructions + task prompt
    full_prompt = f"{agent_instructions}{skill_hint}\n\n---\n\nTASK: {prompt}"

    # Build the command to run in the pane
    cmd = (
        f"cd {shlex.quote(project_root)} && "
        f"agy -p {shlex.quote(full_prompt)} "
        f"--model {shlex.quote(model)} "
        f"--dangerously-skip-permissions"
    )

    # Run the command in the pane
    r = herdr("pane", "run", pane_id, cmd)
    if r.returncode != 0:
        print(f"Failed to run command: {r.stderr}", file=sys.stderr)
        sys.exit(1)

    # Wait for completion
    if marker:
        r = herdr("pane", "wait-output", "--regex", marker, "--timeout", str(timeout * 1000), pane_id)
        if r.returncode != 0:
            print(f"Marker '{marker}' not found within timeout: {r.stderr}", file=sys.stderr)
    else:
        deadline = time.time() + timeout
        while time.time() < deadline:
            r = herdr("pane", "read", pane_id, "--source", "recent", "--lines", "5")
            try:
                content = json.loads(r.stdout).get("result", {}).get("content", "")
                lines = content.strip().splitlines()
                if lines and (lines[-1].endswith("$") or lines[-1].endswith(">") or lines[-1].endswith("#")):
                    if "agy -p" not in lines[-1]:
                        break
            except Exception:
                pass
            time.sleep(2)
        else:
            print(f"Timeout waiting for command to finish", file=sys.stderr)

    print(pane_id)

if __name__ == "__main__":
    main()