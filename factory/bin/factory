#!/usr/bin/env python3
"""factory/bin/factory — Autonomous Software Factory CLI for Google Antigravity (agy)."""
from __future__ import annotations

import argparse
import json
import os
import sys

FACTORY_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REPO_ROOT = os.path.dirname(FACTORY_DIR)
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from factory.lib.config import load_config
from factory.lib.gate_runner import run_gate
from factory.lib.git_ops import GitHubClient
from factory.lib.pipeline import format_status_table, run_doctor, run_factory
from factory.lib.state import list_jobs, load_job


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="factory",
        description="Autonomous Software Factory for Google Antigravity (agy)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_run = sub.add_parser("run", help="Drain queued factory issues or process one issue number")
    p_run.add_argument("issue", nargs="?", type=int, help="Optional GitHub issue number")

    sub.add_parser("queue", help="List open eligible factory-labeled GitHub issues")

    p_status = sub.add_parser("status", help="Show job status summary or detailed JSON for one job")
    p_status.add_argument("job_id", nargs="?", help="Optional job id (e.g. job-42)")

    p_gate = sub.add_parser("gate", help="Run protected_paths + factory/checks.sh for a job worktree")
    p_gate.add_argument("job_id", help="Job id (e.g. job-42)")
    p_gate.add_argument("worktree", nargs="?", help="Worktree path (defaults to .worktrees/<job_id>)")
    p_gate.add_argument("round", nargs="?", type=int, default=1, help="Round number (default: 1)")

    sub.add_parser("doctor", help="Verify git, gh, agy, config.json, checks.sh, and .gitignore")

    args = parser.parse_args(argv)
    jobs_dir = os.path.join(FACTORY_DIR, "jobs")

    if args.command == "run":
        jobs = run_factory(REPO_ROOT, issue_number=args.issue)
        print(format_status_table(jobs))
        return 0

    if args.command == "queue":
        cfg = load_config(FACTORY_DIR)
        gh = GitHubClient(REPO_ROOT)
        for iss in gh.list_queue_issues(cfg):
            print(f"{iss['number']}\t{iss['title']}\t{iss['url']}")
        return 0

    if args.command == "status":
        if args.job_id:
            job = load_job(jobs_dir, args.job_id)
            print(json.dumps(job, indent=2))
            return 0
        print(format_status_table(list_jobs(jobs_dir)))
        return 0

    if args.command == "gate":
        cfg = load_config(FACTORY_DIR)
        wt = args.worktree or os.path.join(REPO_ROOT, ".worktrees", args.job_id)
        passed, md = run_gate(REPO_ROOT, args.job_id, wt, args.round, cfg)
        print(md)
        return 0 if passed else 1

    if args.command == "doctor":
        ok, messages = run_doctor(REPO_ROOT)
        for msg in messages:
            print(msg)
        return 0 if ok else 1

    return 1


if __name__ == "__main__":
    sys.exit(main())
