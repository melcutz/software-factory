#!/usr/bin/env python3
"""factory/bin/factory — Autonomous Software Factory CLI wrapper for Google Antigravity (agy)."""
from __future__ import annotations

import os
import sys

FACTORY_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ENGINE_ROOT = os.path.dirname(FACTORY_DIR)
if ENGINE_ROOT not in sys.path:
    sys.path.insert(0, ENGINE_ROOT)

from factory.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
